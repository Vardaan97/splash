# Source explicitly in an exclusive test window: source dev/scripts/flashnext-max.env
# A/B already run by default. C keeps the existing cost policy and adaptive depth.
export SPLASH_MTP=1
export SPLASH_MTP_DRAFT_VOCAB=1
export SPLASH_MTP_DEPTH=cost
export SPLASH_MTP_ADAPTIVE=1
export SPLASH_MTP_DRAFTS=7
# D: prefer 16K near the full window; 8K is a higher-memory experiment.
# Use --state-format fp32 for strict identity. bf16 + grid changes numerics.
export SPLASH_GDN_CHECKPOINT_TOKENS=16384
# E/F: new runtime behavior is default-off unless explicitly enabled here.
export SPLASH_DECODE_DISPATCH=1
export SPLASH_MTP_LOOKUP=1

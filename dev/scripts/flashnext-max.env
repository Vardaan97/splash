# source dev/scripts/flashnext-max.env; flashnext_profile max-c selects C.
# Or set FLASHNEXT_MAX_PROFILE=max-c before sourcing. Default profile: max.
export SPLASH_MTP=1
export SPLASH_MTP_DRAFT_VOCAB=32768
export SPLASH_MTP_DEPTH=rule
export SPLASH_MTP_ADAPTIVE=1
export SPLASH_MTP_DRAFTS=7
export SPLASH_GDN_CHECKPOINT_TOKENS=16384
export SPLASH_DECODE_DISPATCH=2
export SPLASH_MTP_LOOKUP=1
export SPLASH_MTP_LOOKUP_BUCKETS=1
export SPLASH_MTP_LOOKUP_SCAN=8192
export SPLASH_MTP_LOOKUP_REPROBE=1
export SPLASH_HOST_WINS=1
export SPLASH_PLE_PREFETCH=1
export SPLASH_GRAPH_CACHE=1
flashnext_profile() {
  case "${1:-max}" in
    max) export SPLASH_MTP_DEPTH=rule ;;
    max-c) export SPLASH_MTP_DEPTH=cost ;;
    *) echo 'Profile must be max or max-c' >&2; return 2 ;;
  esac
}
flashnext_profile "${FLASHNEXT_MAX_PROFILE:-max}"
# CLI choices stay explicit: --state-format fp32 --ple-ssd-cache 2G.
# E2 awaits the exclusive M5 dispatch-floor prerequisite and identity gates.

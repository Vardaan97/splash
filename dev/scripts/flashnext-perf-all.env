# Source this to clear inherited SPLASH flags and select the perf-all baseline.
# Turn on exactly one package via the M5 block; this file enables none.
for splash_perf_flag in $(env | cut -d= -f1 | grep '^SPLASH_'); do unset "$splash_perf_flag"; done
unset splash_perf_flag
export SPLASH_MTP=1
export SPLASH_MTP_DEPTH=rule
export SPLASH_MTP_ADAPTIVE=1
export SPLASH_MTP_DRAFTS=7
export SPLASH_MTP_DRAFT_VOCAB=32768
# CACHE: --persistent-cache / FN2_CACHE_SIZE=16G is opt-in; default size is 0.
